# Copy to .env and fill in the secrets:  cp .env.example .env

# Public domain. Caddy gets a Let's Encrypt certificate for it automatically.
# Use DOMAIN=localhost to run the full stack on your own machine.
DOMAIN=api.nasser-dev.om

# local | staging | production  (production refuses "changethis" secrets)
ENVIRONMENT=production

PROJECT_NAME="GradIntel"

# Backend
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@nasser-dev.om
FIRST_SUPERUSER_PASSWORD=changethis
# Only needed for extra origins (e.g. Vite dev server). Same-domain needs nothing.
BACKEND_CORS_ORIGINS=

# LLMs
GEMINI_API_KEY=
# Ollama running on the host machine, used for embeddings (embeddinggemma)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Emails (optional, for password recovery)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@nasser-dev.om
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

SENTRY_DSN=
